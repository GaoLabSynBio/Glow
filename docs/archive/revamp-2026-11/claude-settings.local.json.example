{
  "_comment": "Copy to .claude/settings.local.json (gitignored). Allow-list for the unattended revamp runner: python/pytest in the shared env, read-only shell tools, and git without push/history rewrite.",
  "permissions": {
    "allow": [
      "Read",
      "Edit(./**)",
      "Bash(/home/shared/envs/glow_envs/bin/python *)",
      "Bash(/home/shared/envs/glow_envs/bin/python3 *)",
      "Bash(/home/shared/envs/glow_envs/bin/pytest *)",
      "Bash(/home/shared/envs/glow_envs/bin/streamlit *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git log)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git branch)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(sed -n *)",
      "Bash(find *)",
      "Bash(mkdir *)",
      "Bash(date *)",
      "Bash(date)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git reset --hard *)",
      "Bash(git rebase *)",
      "Bash(git filter-repo *)",
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(pip install *)",
      "Bash(conda *)",
      "WebFetch",
      "WebSearch"
    ]
  }
}
